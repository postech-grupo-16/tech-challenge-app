{
  "name": "tech-challenge-app",
  "description": "Latência das APIs, indicadores de negócio, Ordens de Serviço, Kubernetes, healthcheck e logs. Troque o ambiente pelas variáveis Aplicação e Cluster.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Visão geral",
      "description": null,
      "widgets": [
        {
          "title": "Disponibilidade (% sem 5xx)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8656379
                ],
                "query": "SELECT percentage(count(*), WHERE httpResponseCode < '500') AS 'Disponibilidade %' FROM Transaction WHERE appName = {{app}} AND transactionType = 'Web' AND request.uri NOT LIKE '/actuator%'"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Latência p95 (s)",
          "layout": {
            "column": 3,
            "row": 1,
            "width": 2,
            "height": 3
