          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8656379
                ],
                "query": "SELECT percentile(duration, 95) AS 'p95 (s)' FROM Transaction WHERE appName = {{app}} AND transactionType = 'Web' AND request.uri NOT LIKE '/actuator%'"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
